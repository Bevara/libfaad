{
    "name": "libfaad",
    "version": "1.0.1",
    "description": "FAAD decoder",
    "filters": [
        "faad",
        "rfadts"
    ],
    "help": "This filter decodes AAC streams through faad library.",
    "support": [
        "audio"
    ],
    "sources": "https://codeload.github.com/Bevara/libfaad/zip/refs/heads/main",
    "filter_source": {
        "faad": "dec_faad.c",
        "rfadts": "reframe_adts.c"
    },
    "Format": ["AAC"],
    "using": ["solver_minimal_1", "solver_1"],
    "patents": {
        "status": "licence-required",
        "note": "AAC: Via LA",
        "checked": "2026-10-16"
    }
}
